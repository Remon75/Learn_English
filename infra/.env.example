# Sparkle English - deployment configuration
#
# Copy this file to `.env` and edit it. Never commit the real `.env`.

# The public hostname of this instance. Caddy obtains a certificate for it.
SPARKLE_DOMAIN=learn.example.com

# Where Caddy sends expiry warnings. This is the only address used.
ACME_EMAIL=you@example.com

# Host ports. Change these if 80 and 443 are already in use.
SPARKLE_HTTP_PORT=80
SPARKLE_HTTPS_PORT=443
