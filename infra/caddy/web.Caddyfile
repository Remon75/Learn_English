# Sparkle English - static file server
#
# Serves the built PWA. The edge proxy in front of this service handles
# TLS and all routing.

{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# The service worker and the app shell must always be revalidated, or
	# a stale worker can pin a child to an old version of the app.
	@sw path /sw.js /index.html /manifest.webmanifest
	header @sw Cache-Control "no-cache"

	# Hashed build assets never change.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
